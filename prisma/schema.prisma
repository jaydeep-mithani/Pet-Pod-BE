generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PetSpecies {
  DOG
  CAT
  RABBIT
  BIRD
  SMALL
  OTHER
}

enum PetSize {
  SMALL
  MEDIUM
  LARGE
}

enum PetStatus {
  AVAILABLE
  PENDING
  ADOPTED
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  // Optional: Google-signed-up users start without one. Linking a password
  // later is fine — we'd just hash and store as we do for native signup.
  passwordHash    String?
  // Optional: only present for users who signed in via Google. Unique so we
  // can look users up by their Google ID on subsequent logins.
  googleId        String?   @unique
  name            String
  avatarUrl       String?
  bio             String?
  city            String?
  region          String?
  country         String?
  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?
  // Bumped whenever the password is reset. JwtStrategy compares against the
  // token's iat to revoke still-outstanding access tokens after a reset.
  passwordChangedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  pets                 Pet[]
  ownerConversations   Conversation[] @relation("OwnerConversations")
  adopterConversations Conversation[] @relation("AdopterConversations")
  sentMessages         Message[]
  refreshTokens        RefreshToken[]
  emailVerifications   EmailVerification[]
  passwordResets       PasswordReset[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmailVerification {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash    String
  attempts    Int       @default(0)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
}

model PasswordReset {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SHA-256 of the plaintext token. Unique so we can findUnique on the
  // hashed value (effectively O(log n)) and so the constraint documents
  // intent.
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
}

model Pet {
  id                String     @id @default(cuid())
  name              String?
  species           PetSpecies
  breed             String?
  ageMonths         Int
  size              PetSize
  shortDescription  String     @db.VarChar(280)
  story             String?
  reasonForRehoming String?
  city              String
  region            String?
  country           String
  status            PetStatus  @default(AVAILABLE)
  ownerId           String
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  photos        Photo[]
  conversations Conversation[]

  @@index([status, createdAt])
  @@index([ownerId])
}

model Photo {
  id        String   @id @default(cuid())
  petId     String
  url       String
  publicId  String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId])
}

model Conversation {
  id        String   @id @default(cuid())
  petId     String
  ownerId   String
  adopterId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pet      Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)
  owner    User      @relation("OwnerConversations", fields: [ownerId], references: [id], onDelete: Cascade)
  adopter  User      @relation("AdopterConversations", fields: [adopterId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([petId, adopterId])
  @@index([ownerId])
  @@index([adopterId])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  deliveredAt    DateTime?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
