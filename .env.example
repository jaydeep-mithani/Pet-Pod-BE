NODE_ENV=development
PORT=4000

# CORS: comma-separated allowlist for production deploys (e.g. https://petpod.app).
# In dev, any http://localhost:<port> is allowed automatically — leave this empty.
FRONTEND_ORIGINS=

# Database (Neon connection string — get one at https://console.neon.tech/)
# Format: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=

# JWT secrets — generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Cookies (leave COOKIE_DOMAIN blank for localhost; set in production)
COOKIE_DOMAIN=
COOKIE_SECURE=false

# Cloudinary (image hosting — sign up at https://cloudinary.com)
# Found under Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Swagger / OpenAPI docs at /docs.
# Enable on dev and stage; leave unset (or false) in production to avoid
# publishing the full API surface to the world.
SWAGGER_ENABLED=true

# SMTP for transactional email. Currently Gmail (alpha stage — no domain yet).
# Swap to any other SMTP provider (Mailgun, SendGrid, Postmark, etc.) by
# changing these four values; no code changes needed.
#
# Gmail setup:
#   1. Enable 2-Step Verification on the Gmail account.
#   2. Google Account → Security → App passwords → generate a 16-char code.
#   3. Use that code as SMTP_PASS (not your normal Gmail password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Sender shown in the inbox. The address part should match SMTP_USER for Gmail
# (Gmail rewrites mismatched From headers via DMARC anyway). Display name is
# free to customise.
EMAIL_FROM=Pet Pod <youraddress@gmail.com>
# Where verification links/landing pages live (used in email copy and as
# the post-OAuth redirect target).
APP_URL=http://localhost:5500

# Google OAuth — create credentials at https://console.cloud.google.com →
# APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URI must match GOOGLE_CALLBACK_URL exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4100/auth/google/callback
